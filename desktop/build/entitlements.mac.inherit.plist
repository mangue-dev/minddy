<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements inherited by Electron helpers and embedded frameworks.

  The APNs entitlement belongs only to the main application bundle. Applying it
  to every helper makes the helper signatures carry an application capability
  that those executables do not use and that Apple can reject independently.
  The runtime and audio entitlements remain inherited because Electron's
  renderer and GPU processes need them while the packaged application runs.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
