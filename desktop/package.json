{
  "name": "minddy-desktop",
  "version": "0.10.22",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The minddy desktop shell — a window into www.minddy.app",
  "author": "mangue <hello@minddy.app>",
  "homepage": "https://www.minddy.app",
  "desktopName": "minddy",
  "main": "dist/main.js",
  "scripts": {
    "build": "node ../scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run dist:win:store",
    "dist:win:store": "npm run build && node ../scripts/build-windows-store.mjs"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
