{
  "name": "minddy-desktop",
  "version": "0.9.2",
  "private": true,
  "description": "La coquille macOS de minddy — une fenêtre sur www.minddy.app",
  "author": "mangue <hello@minddy.app>",
  "homepage": "https://www.minddy.app",
  "main": "dist/main.js",
  "scripts": {
    "build": "node ../scripts/build-desktop.mjs",
    "icon": "node ../scripts/build-desktop-icon.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
