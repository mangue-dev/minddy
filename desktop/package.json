{
  "name": "minddy-desktop",
  "version": "0.11.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The minddy desktop shell — a window into www.minddy.app",
  "author": "mangue <hello@minddy.app>",
  "homepage": "https://www.minddy.app",
  "desktopName": "minddy",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "npm run verify:dependency-security",
    "verify:dependency-security": "node ../scripts/patch-desktop-http-cache.mjs && npm run test:dependency-security",
    "test:dependency-security": "node --test ../scripts/desktop-http-cache.test.mjs",
    "build": "npm run verify:dependency-security && node ../scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run dist:win:store",
    "dist:win:store": "npm run build && node ../scripts/build-windows-store.mjs"
  },
  "devDependencies": {
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
