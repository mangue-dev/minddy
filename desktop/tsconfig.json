{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    // Like the root tsconfig, and for the same reason: these files are
    // BUNDLED by esbuild (scripts/build-desktop.mjs), which alone decides the
    // output format. With `node16`, `tsc` rejected type imports from
    // `lib/` — ESM code read from a CJS module — although none of this
    // exists yet when the bundle is written.
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["src/**/*.ts"]
}
