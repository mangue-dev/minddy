{
  "buildCommand": "npm run check:deployment-db && npm run build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "production": true
    }
  },
  "crons": [
    { "path": "/api/cron/custom-domains", "schedule": "25 * * * *" },
    { "path": "/api/cron/feedback-analysis", "schedule": "0 * * * *" },
    { "path": "/api/cron/agent-drain", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/numo-turns", "schedule": "* * * * *" },
    { "path": "/api/cron/forge-relay-deliveries", "schedule": "* * * * *" },
    { "path": "/api/cron/forge-relay-maintenance", "schedule": "35 * * * *" },
    { "path": "/api/cron/automations", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/smart-assign", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/routines", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/billing-sync", "schedule": "15 * * * *" },
    { "path": "/api/cron/fx-rate", "schedule": "30 15 * * *" },
    { "path": "/api/cron/encryption-maintenance", "schedule": "15 * * * *" },
    { "path": "/api/cron/data-retention", "schedule": "45 3 * * *" }
  ]
}
