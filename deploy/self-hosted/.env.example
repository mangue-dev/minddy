# This guided file is intentionally smaller than the root .env.example.
# Read ../../.env.example before enabling an optional application integration.

# The release compatibility row this deployment follows. Do not change only one
# of these image values: upgrade them as one published minddy release set.
MINDDY_RELEASE=0.10.19
MINDDY_IMAGE=ghcr.io/mangue-dev/minddy:v0.10.19
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
SCHEDULER_IMAGE=node:24.12.0-alpine3.22@sha256:4f4a059445c5a6ef2b9d169d9afde176301263178141fc05ba657dab1c84f9a7

# Use absolute paths. The complete profile combines this file with the upstream
# Supabase Compose file, whose relative paths belong to the upstream checkout.
MINDDY_DEPLOY_DIR=/srv/minddy/release/deploy/self-hosted
MINDDY_ENV_FILE=/srv/minddy/release/deploy/self-hosted/.env

# Caddy terminates TLS when this is a DNS hostname. Use http://localhost only
# for a disposable non-TLS smoke run.
MINDDY_HOST=tickets.example.com
SUPABASE_HOST=supabase.example.com
CADDY_EMAIL=ops@example.com
MINDDY_HTTP_BIND_ADDRESS=0.0.0.0

# Required minddy runtime configuration. Use the exact public HTTPS origins.
MINDDY_EDITION=self-hosted
MINDDY_PUBLIC_APP_URL=https://tickets.example.com
MINDDY_PUBLIC_SUPABASE_URL=https://supabase.example.com
MINDDY_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
MINDDY_MANAGED_AI=0
MINDDY_MANAGED_BILLING=0
# `local` supports only desktop-initiated agent runs. Scheduled routines need
# Vercel Sandbox, even when this Compose deployment is not hosted on Vercel.
# To enable them, set this to `vercel` and provide the three Vercel variables
# below. See ../../docs/self-hosting.md for the scheduler requirement.
AGENT_EXECUTION_BACKEND=local
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# The initial administrator and public operator contact. Add more addresses as
# a comma-separated list only after they have been verified by the operator.
ADMIN_EMAILS=ops@example.com
MINDDY_PUBLIC_CONTACT_EMAIL=ops@example.com

# Scheduler is disabled unless the scheduled-jobs Compose profile is selected.
# Generate a distinct 32-byte-or-longer value and do not log it.
CRON_SECRET=replace-with-a-long-random-secret
MINDDY_SCHEDULER_URL=http://minddy:3000

# The following values are consumed by the complete official Supabase profile.
# Replace every upstream placeholder and copy advanced options from the pinned
# upstream docker/.env.example fetched by scripts/fetch-official-supabase.mjs.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
ANON_KEY=replace-with-supabase-anon-key
SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SECRET_KEY_BASE=replace-with-a-long-random-secret
VAULT_ENC_KEY=replace-with-32-character-secret
PG_META_CRYPTO_KEY=replace-with-a-long-random-secret
LOGFLARE_PUBLIC_ACCESS_TOKEN=replace-with-a-long-random-secret
LOGFLARE_PRIVATE_ACCESS_TOKEN=replace-with-a-long-random-secret
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-random-access-key
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-random-secret
SUPABASE_PUBLIC_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com/auth/v1
SITE_URL=https://tickets.example.com
ADDITIONAL_REDIRECT_URLS=https://tickets.example.com/auth/callback
