# Self-hosted deployment environment template
#
# Copy this file to a protected .env and replace every placeholder. This
# template is intentionally deployment-focused; see ../../.env.example for
# the complete reference for optional application integrations.
#
# The managed profile uses an existing Supabase project. The full profile also
# reads the official Supabase Docker environment values listed at the end of
# this file.

# =============================================================================
# 1. Release pins
# =============================================================================

# Keep these release values together. Upgrade them only as one published
# minddy release set; the compatibility matrix validates the image digests.
MINDDY_RELEASE=0.10.24
MINDDY_IMAGE=ghcr.io/mangue-dev/minddy:v0.10.24
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
SCHEDULER_IMAGE=node:24.12.0-alpine3.22@sha256:4f4a059445c5a6ef2b9d169d9afde176301263178141fc05ba657dab1c84f9a7

# =============================================================================
# 2. Deployment paths
# =============================================================================

# Use absolute paths. MINDDY_DEPLOY_DIR points to this release's deployment
# directory; MINDDY_ENV_FILE is the protected environment file Compose reads.
MINDDY_DEPLOY_DIR=/srv/minddy/release/deploy/self-hosted
MINDDY_ENV_FILE=/srv/minddy/release/deploy/self-hosted/.env

# =============================================================================
# 3. Public host, TLS, and network bindings
# =============================================================================

# For public HTTPS, use DNS hostnames and provide CADDY_EMAIL. For a private
# installation, use an RFC1918 address and keep all router ports closed.
MINDDY_HOST=tickets.example.com
MINDDY_SITE_ADDRESS=tickets.example.com
SUPABASE_HOST=supabase.example.com
SUPABASE_SITE_ADDRESS=supabase.example.com
CADDY_EMAIL=ops@example.com

# Caddy's host bind address. The complete profile publishes Supabase's API
# through this proxy as well.
MINDDY_HTTP_BIND_ADDRESS=0.0.0.0

# Complete-profile Supabase API binding. Use 0.0.0.0 only for a trusted LAN;
# public installations should keep the upstream API loopback-only.
MINDDY_SUPABASE_HTTP_BIND_ADDRESS=127.0.0.1
MINDDY_SUPABASE_HTTP_PORT=8000

# Host loopback port for PostgreSQL bootstrap and maintenance. PostgreSQL is
# never published publicly by the reference profile.
MINDDY_POSTGRES_BIND_PORT=54322

# =============================================================================
# 4. Core minddy configuration
# =============================================================================

MINDDY_EDITION=self-hosted
MINDDY_PUBLIC_APP_URL=https://tickets.example.com
MINDDY_PUBLIC_SUPABASE_URL=https://supabase.example.com
MINDDY_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Managed AI and billing are disabled for self-hosted installations. The
# installer records selected optional features in this comma-separated value.
MINDDY_MANAGED_AI=0
MINDDY_MANAGED_BILLING=0
MINDDY_SELF_HOST_FEATURES=

# =============================================================================
# 5. Administrator, public contact, and scheduled jobs
# =============================================================================

ADMIN_EMAILS=ops@example.com
MINDDY_PUBLIC_CONTACT_EMAIL=ops@example.com

# The installer generates this secret. The scheduler sends it to the internal
# cron routes, so keep the value private.
CRON_SECRET=replace-with-a-long-random-secret
MINDDY_SCHEDULER_URL=http://minddy:3000

# =============================================================================
# 6. Application encryption and agent runner
# =============================================================================

# These secrets are generated for every installation. Keep them stable across
# upgrades so existing encrypted data remains readable.
AI_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret
FEEDBACK_SSO_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# The reference profiles run the isolated Docker sandbox through this runner.
# The runner port must remain on the private Docker network.
AGENT_EXECUTION_BACKEND=self-hosted
AGENT_RUNNER_URL=http://agent-runner:6464
AGENT_RUNNER_SECRET=replace-with-a-long-random-secret
AGENT_CONTROL_ORIGIN=http://minddy:3000

# =============================================================================
# 7. Optional application email
# =============================================================================

# Leave these empty to keep application email disabled. The installer fills in
# the encryption and signing secrets when the capability is selected.
EMAIL_PROVIDER=
RESEND_API_KEY=
FEEDBACK_EMAIL_FROM=
INVITATION_EMAIL_FROM=

# =============================================================================
# 8. Optional Web Push
# =============================================================================

MINDDY_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# =============================================================================
# 9. Optional GitHub and GitLab connections
# =============================================================================

# Operator-owned provider credentials are optional. Configure the complete
# provider block and the matching encryption/signing secrets when selected.
GIT_STATE_SECRET=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GIT_TOKEN_ENCRYPTION_SECRET=

# =============================================================================
# 10. Managed forge relay
# =============================================================================

# Enabled by default on self-hosted installations. The instance provisions its
# relay identity on first connection and stores it in its own database. Set
# MINDDY_FORGE_RELAY=0 to opt out and use only operator-owned apps above.
MINDDY_FORGE_RELAY=
MINDDY_FORGE_RELAY_URL=
MINDDY_FORGE_RELAY_INSTANCE_ID=
MINDDY_FORGE_RELAY_SECRET=

# Normally generated during provisioning. Set this only to pin an explicit
# webhook fan-out secret.
MINDDY_FORGE_RELAY_WEBHOOK_SECRET=

# =============================================================================
# 11. Optional Vercel Sandbox fallback
# =============================================================================

# Vercel Sandbox is an alternative for non-reference deployments. It is not
# needed when AGENT_EXECUTION_BACKEND=self-hosted.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# =============================================================================
# 12. Official Supabase full-profile values
# =============================================================================

# The full profile combines this file with the pinned upstream Supabase
# docker/.env.example. Replace every upstream placeholder and copy advanced
# options from that pinned template fetched by scripts/fetch-official-supabase.mjs.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
ANON_KEY=replace-with-supabase-anon-key
SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SECRET_KEY_BASE=replace-with-a-long-random-secret
VAULT_ENC_KEY=replace-with-32-character-secret
PG_META_CRYPTO_KEY=replace-with-a-long-random-secret
LOGFLARE_PUBLIC_ACCESS_TOKEN=replace-with-a-long-random-secret
LOGFLARE_PRIVATE_ACCESS_TOKEN=replace-with-a-long-random-secret
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-random-access-key
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-random-secret
SUPABASE_PUBLIC_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com/auth/v1
SITE_URL=https://tickets.example.com
ADDITIONAL_REDIRECT_URLS=https://tickets.example.com/auth/callback
