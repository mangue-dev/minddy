{
  email {$CADDY_EMAIL}
}

{$MINDDY_SITE_ADDRESS} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  @database_import path_regexp database_import ^/api/projects/[^/]+/pages/[^/]+/import/?$
  request_body @database_import {
    max_size 21MiB
  }
  @database_import_plan path_regexp database_import_plan ^/api/projects/[^/]+/pages/import-plan/?$
  request_body @database_import_plan {
    max_size 2MiB
  }
  reverse_proxy minddy:3000
}

{$SUPABASE_SITE_ADDRESS} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # The Storage S3 protocol is disabled in compose.full.yml; refuse its route
  # here too (GHSA-2p28-q2vx-mw6w).
  respond /storage/v1/s3* 404
  reverse_proxy api-gw:8000
}
