# Public URL at which this project is served. Defaults to https://www.minddy.app.
NEXT_PUBLIC_SITE_URL=https://www.minddy.app

# Public destination of calls to action. This is an URL, not an API credential.
NEXT_PUBLIC_APP_URL=https://app.minddy.app

# Optional client-side analytics. Both values are public by design.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
