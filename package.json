    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap:supabase": "node scripts/bootstrap-supabase.mjs",
    "verify:supabase": "node scripts/verify-supabase-bootstrap.mjs",
    "test:bootstrap:supabase": "node --test scripts/bootstrap-supabase.test.mjs",
