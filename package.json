  "scripts": {
    "predev": "npm run build:agent-vm && npm run build:pages-md",
    "dev": "NODE_OPTIONS=--max-http-header-size=32768 next dev",
    "prebuild": "npm run build:agent-vm && npm run build:pages-md",
    "build": "next build",
    "build:agent-vm": "node scripts/build-agent-vm.mjs",
    "build:pages-md": "node scripts/build-pages-md.mjs",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop:check": "node scripts/desktop-fingerprint.mjs --explain",
