#minddy — Supabase (dedicated instance, separate from AutoKap)
#Copy these keys into .env (gitignored) with the real values ​​of your Supabase project.
#
#⚠ The secrets that serve as KEY (encryption, HMAC, webhook signature) are
#CHECKED AT STARTUP — catalog and lengths in lib/server/env-secrets.ts,
#control in instrumentation.ts. Too short, empty or missing (online): the
#server refuses to start and says which one. Hit them with `openssl rand -hex 32`.

# Canonical public origin of THIS instance, without a path or trailing slash.
#Absent, development uses http://localhost:3000; no url minddy
#is not chosen as the implicit destination. Mandatory as soon as the instance is
#public (invitation links, OAuth/MCP, GitLab webhooks, metadata).
MINDDY_PUBLIC_APP_URL=
#Server-side deployment edition. Leave empty (or set self-hosted) for every
#operator-managed installation. Minddy Cloud Ops sets cloud explicitly; no
#hostname, Git branch, or Vercel variable changes this choice.
MINDDY_EDITION=self-hosted
#Public brand values. Leaving them empty preserves the brand of the project;
#operators who distribute an instance under another identity pose them.
MINDDY_PUBLIC_SITE_NAME=
MINDDY_PUBLIC_CONTACT_EMAIL=
#Optional “Share Feedback” sidebar link. Absent, the action
#is hidden and no destination operated by minddy is implicitly chosen.
MINDDY_PUBLIC_PRODUCT_FEEDBACK_URL=
#Public page telemetry via Vercel Analytics + Speed ​​Insights.
#Explicit opt-in: absent, no Vercel measurement component is mounted.
MINDDY_PUBLIC_VERCEL_ANALYTICS=

# Dashboard Supabase → Project Settings → API
MINDDY_PUBLIC_SUPABASE_URL=
MINDDY_PUBLIC_SUPABASE_ANON_KEY=

#service_role key (server secret — never exposed to the client).
#Not yet consumed at the “Foundations” site, documented for the “Projects” site.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (assistant Numo) — https://openrouter.ai/keys
#The model used is configured in base (app_config table, assistant_model/fallback_model keys).
OPENROUTER_API_KEY=

#OpenRouter PROVISIONING Key (MIN-223) — https://openrouter.ai/settings/provisioning-keys
#Used to issue, for each run of the code agent, a HARD CEILING key that the
#microVM's firewall injects in its place. It is this ceiling, held by the supplier,
#which limits what a hostile model could spend by calling the credited route out
#of the loop — network policy prevents it from READING the key, not USING it.
#It NEVER goes down into the network policy or into the VM: it does not come out of the
#function. Empty → we fall back on OPENROUTER_API_KEY, without supplier ceiling, and the
#logs say so.
OPENROUTER_PROVISIONING_KEY=

#Administrators of this instance — comma-separated list of emails.
#Opens the `/admin` table (AI models, finances, support and overrides of
#plan). Accounts bearing `app_metadata.role = "admin"` are also accepted.
ADMIN_EMAILS=

#Coming from the OAuth 2.1 server (MIN-346) — the origin announced by the documents
#.well-known and expected in `resource`. Empty in the normal case: the production takes
#the canonical domain, a preview takes its own deployment, the post takes
#its localhost. To be completed ONLY when the app is joined by another
#address than that (ngrok tunnel to test an MCP client, test domain).
#What you should definitely not do is derive it from a request header: this
#would let the caller choose who minddy sends its users to.
OAUTH_ISSUER=

# At-rest encryption for board SSO secrets (AES-256-GCM, 32+ bytes).
#The secret of a board allows you to forge the identity of any of its
# visitors: it must not rest in plaintext in the database (MIN-119). Absent →
#GENERATE SSO secret fails (fail-closed); the secrets already laid remain
#readable and are resealed as soon as the variable arrives. To be installed BEFORE
#deployment if boards are already using SSO.
FEEDBACK_SSO_ENCRYPTION_SECRET=

#Custom Domains (MIN-36) — attaches client CNAMEs to the Vercel project.
#VERCEL_TOKEN: access token (https://vercel.com/account/tokens), scope of
#team that hosts minddy. VERCEL_PROJECT_ID: project id (Settings → General,
#or .vercel/project.json). VERCEL_TEAM_ID: required if the project lives in a team.
#Absent → the “Custom Domain” section is hidden in the UI.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
#Dev only: =1 to mock the Vercel API (everything responds successfully/verified) and test
#the complete flow locally without token. Ignored in production.
MDY_FAKE_VERCEL_DOMAINS=
#minddy.app subdomains allowed as custom domains (dogfooding),
#separated by commas — e.g. feedback.minddy.app. *.minddy.app remains
#prohibited otherwise (no one claims a subdomain of the brand), and the
#app hosts (www/preview/apex) are never allowlistable.
MDY_CUSTOM_DOMAIN_ALLOWLIST=

# ── Google / GitHub sign-in (MIN-77) ──────────────────────────────────────────
#NO variables here: social providers are configured in the Dashboard
#Supabase (Authentication → Sign In / Providers), not in the repository. This block
#is the doc for this config — the /login buttons simply call
#supabase.auth.signInWithOAuth() and fail as long as a provider is disabled.
#
#   1. Google — Google Cloud Console → APIs & Services → Credentials → OAuth
#      client ID (type « Web application ». Authorized redirect URI :
#      https://<ref>.supabase.co/auth/v1/callback (ref = the one in the Supabase URL).
#Paste Client ID + Client secret into the Supabase Google provider.
#   2. GitHub — https://github.com/settings/developers → OAuth Apps → New.
#PLEASE NOTE: this is a SEPARATE OAuth App, unrelated to the GitHub App
#GITHUB_APP_* below (which is used to link the repositories).
#      Authorization callback URL : https://<ref>.supabase.co/auth/v1/callback.
#Paste Client ID + Client secret into the Supabase GitHub provider.
#   3. Supabase → Authentication → URL Configuration → Redirect URLs, add:
#        https://<votre-origine>/auth/callback
#        http://localhost:3000/auth/callback
#https://*-<team>.vercel.app/auth/callback (preview deployments)
#Without allowlist, the return from the provider is returned to the Site URL.
#
#Please note: Supabase automatically attaches a social identity to the account
#existing one that has the same VERIFIED email. An account created by password then
#reconnected via Google therefore remains one and the same user (same user id).

# ── Transactional email (MIN-117) ────────────────────────────────────────────
#Authentication emails (registration confirmation, reset)
#start from GoTrue, not from the app: their config lives in the Supabase Dashboard,
#and this block is the only versioned trace of it.
#
#1. Choose an SMTP provider and verify a domain controlled by
#the operator (ideally a dedicated email subdomain, to isolate its
#reputation). With Resend, create an API key DEDICATED to Supabase SMTP: one
#key by use allows you to revoke one without turning off the other.
#   2. Supabase → Authentication → Emails → SMTP Settings:
#        Host/port/username/password = those of the chosen provider
#        Sender noreply@<votre-domaine-mail> · Sender name <votre-marque>
#This Sender lives in the Supabase dashboard, NOT in this file: it does not have
#followed the domain alone. If it remained on the root, no more emails
#registration confirmation does not leave — and nothing says it on the app side.
#Without custom SMTP, emails go from noreply@supabase.co and are
#capped at 2 sendings PER HOUR — the 3rd test account receives nothing.
#3. Authentication → Rate Limits → “emails sent per hour”: go up
#ceiling, which remains at 2/h until it is touched.
#   4. Authentication → URL Configuration: Site URL = https://<votre-origine>,
#and the three Redirect URLs from the MIN-77 block above. THIS IS HERE
#repairs a confirmation link that points to localhost in production:
#an origin outside the allowlist is replaced by the Site URL.
#5. Authentication → Emails → Templates → “Confirm signup”: paste the
#body of supabase/email-templates/confirm-signup.html (versioned copy
#      of the template, bilingual EN + FR — GoTrue has only one template per email
#email, without language switch), and its subject:
#        Confirm your email · Confirmez votre adresse e-mail
#The main thing is the link, which must carry a TOKEN and not the
#{{ .ConfirmationURL }} default —
#        {{ .RedirectTo }}?token_hash={{ .TokenHash }}&type=signup&next=/auth/confirmed
#{{ .RedirectTo }} is the validated emailRedirectTo; if it comes out empty
#a real sending, write {{ .SiteURL }}/auth/callback
#hard. WHY: @supabase/ssr registers in PKCE, and the default link
#returns to ?code=…, the exchange of which requires the code_verifier stored in the
#localStorage of the ORIGINAL browser. Registration on PC + confirmation
#on mobile was failing for this reason alone. verifyOtp() does not depend on
#of any device.
#
#Mail sent by the APP (separate from SMTP Auth above). No supplier
#is not chosen by default: EMAIL_PROVIDER=resend active Resend only if its
#key AND both senders specific to your domain are present. Locally,
#EMAIL_PROVIDER=console allows you to display codes and links without a network call; This
#mode is refused in production.
EMAIL_PROVIDER=
RESEND_API_KEY=
FEEDBACK_EMAIL_FROM=
INVITATION_EMAIL_FROM=
# ── Notifications push / web (MIN-183) ───────────────────────────────────────
#Web Push with VAPID: what falls into the inbox also goes into notification
#system, on the installed PWA as on the desktop browser. The PAIR of
#keys identifies the SERVER to push services (FCM, Mozilla, Apple) —
#it is she who signs each shipment, and it is her public half that the
#browser seals in subscription.
#
#Generate the pair only once:
#   npx web-push generate-vapid-keys
#
#⚠ DO NOT ROTATE IT LIGHTLY. A subscription is linked to the public key
#who created it: changing the pair makes ALL subscriptions respond 403
#existing, and each device must re-subscribe. In practice, the same pair in
#Production and Preview.
#
#VAPID_SUBJECT is the contact that the push service sees (`mailto:` or
#`https:`); this is what it uses to prevent abuse. It is required:
#the instance never chooses minddy's contact address for you.
#
#The three absent → sending turns off properly (lib/server/push/vapid.ts):
#the inbox continues to fill up, nothing comes up, a log says so.
MINDDY_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

#Native macOS push via APNs (MIN-356). The .p8 key remains on the server side; replace
#its newlines by `\n` if the host only accepts one line.
# Apple Developer → Certificates, Identifiers & Profiles → Keys.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
#Identifier of YOUR signed build; required to never send to minddy topic.
APNS_BUNDLE_ID=

# ── Auth hardening — Supabase Dashboard (MIN-118) ────────────────────────────
#These settings live in the Dashboard, NOT in an env variable: this block
#is the only versioned trace (like the OAuth and SMTP blocks above).
#To be rechecked after any Supabase project change.
#
#   1. Authentication → Policies (ou Sign In / Providers → Email) :
#- Minimum password length = 8 (the /login form already requires 8 sides
#client, but it is the server which is authentic; keep both aligned).
#- Password requirements: at least “lower + upper + digits” if the
#plan exposes it (otherwise the length alone).
#        - « Leaked password protection » (check HaveIBeenPwned) : ACTIVER si
#available on the plan — refuses already leaked passwords.
#   2. Authentication → Sessions / JWT :
#- Access token (JWT) expiry = 3600 s (1 h). Short on purpose: the
#ES256 local check (getClaims) costs nothing, a stolen token expires quickly.
#- Refresh token rotation = ENABLED, with short “reuse interval”. A
#refresh replayed after rotation revokes the family (theft detection).
#3. Authentication → Rate Limits: keep REASONABLE ceilings on
#“sign in/sign up”, “token refresh”, “OTP” and “password reset”.
#These feeds talk to GoTrue LIVE from the browser — our roads
#API never sees them, so our in-memory rate limit doesn't cover them
#not: it is Supabase which must limit them. Password reset
#Supabase is already single-use and expires (nothing to wire on the app side).
#4. Authentication → Multi-Factor: TOTP activated (the aal2 gate is global
#in getAuthedUser — see SECURITY.md). Nothing to change, just check
#that the TOTP factor remains authorized.

#── Git integration (MIN-47 + MIN-69) ──────────────────── ────────────────────
#Links GitHub/GitLab repositories to projects (read+write — the code agent runs
#on both). Absent → the corresponding supplier is hidden in the
#settings (the app runs without). HMAC secret of connection `state` (32+ bytes):
GIT_STATE_SECRET=
#
# GitHub App for the instance — https://github.com/settings/apps/new
#   Permissions: Contents (R/W), Pull requests (R/W), Metadata (R), and
#Issues (R/W). Issues permission supports issue synchronization and status pushes.
#   Setup URL: https://<your-origin>/api/git/github/setup (+ “Redirect on update”).
#   Webhook: Active, URL https://<your-origin>/api/webhooks/github, secret =
#GITHUB_WEBHOOK_SECRET below (generate 32+ bytes). Subscribe to Pull request,
#Pull request review, Issues, Issue comments, and Issue dependencies. This
#synchronizes agent PR status, issue changes, comments, and blocking relations.
#PLEASE NOTE: a newly granted App permission is not applied to existing
#installations automatically. Each installation must accept the updated Issues
#permission before issue synchronization can use it.
#GITHUB_APP_PRIVATE_KEY: the PEM (single-line with \n escapes accepted).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
#
#USER authorization of the same App (MIN-144) — without it, everything starts from
#installation token and the author listed on GitHub is `<slug-de-l-app>[bot]`.
#On the App page: “Generate a new client secret”, then
#   User authorization callback URL :
#     https://<votre-origine>/api/git/github/user-callback
#(DISTINCT field of the Setup URL, which does not move; do NOT check “Request
#   user authorization (OAuth) during installation” — it would authorize only
#the person installing and would change the post-installation redirect.)
#WARNING, same trap as “Issues (Read)”: the authorization is NEITHER
#retroactive NI inherited from the installation — EACH member must authorize a
#times, from its settings or the PR panel banner.
#“Expires user authorization tokens” decides the presence of a refresh
#token: activated → 8 hour tokens refreshed by themselves; disabled → token
#permanent. Both walk, minddy adapts.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
#
# GitLab OAuth application — https://gitlab.com/-/profile/applications
#   Redirect URI: https://<votre-origine>/api/git/gitlab/callback; scope: api.
#GITLAB_TOKEN_ENCRYPTION_SECRET: token encryption key (32+ bytes).
#Since MIN-144 it ALSO encrypts the GitHub user token, hence its
#new name GIT_TOKEN_ENCRYPTION_SECRET — optional: failing that, the old one
#serves (renaming it without fallback would make the connections already in the base unreadable,
#the scrypt derivation starting from the secret). Only apply ONE of the two.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_TOKEN_ENCRYPTION_SECRET=
GIT_TOKEN_ENCRYPTION_SECRET=
#
#GitLab webhook (MIN-69 / MIN-97) — lives ON THE REPOSITORY (GitLab has no endpoint
#global like the GitHub App). Enable the import of PROVISIONED issues
#automatically (“Issues events” + “Merge request events”, secret set);
#cutting it only sets “Issues events” to false, without removing the hook.
#All that remains is to create BY HAND for a repository that only uses the agent, and in development
#(the provisioned URL comes from SITE_URL, which does not reach localhost):
#   Settings → Webhooks, URL https://<votre-origine>/api/webhooks/gitlab,
#“Merge request events” + “Issue events” triggers.
#
#THE SECRET OF THE HOOK IS SPECIAL TO THE DEPOSIT since MIN-333, generated by minddy and
#stored encrypted in project_git_links — there is nothing more to put here to
#a new installation. GitLab SHOWS the token of a hook to anyone who can
#edit it: a unique secret, written at each tenant, left anyone
#which maintainer to forge events for other people's repositories.
#
#GITLAB_WEBHOOK_SECRET only survives in FALL, for hooks installed BEFORE this
#version: the receiver still accepts them, and burps their secret at the first
#event received. Once all the deposits have been burped, the variable can leave. A
#hook created by hand today must carry the repository secret, readable
#nowhere — rather go through the issue import toggle, which sets it up.
GITLAB_WEBHOOK_SECRET=

# ── Managed forge relay (default on self-hosted) ─────────────────────────────
# GitHub/GitLab connect through the forge relay operated by minddy
# (docs/managed-forge-relay-plan.md). On a self-hosted edition with no
# operator-owned app, the instance provisions its relay identity AUTOMATICALLY
# on first connect and stores it in its own database — no variable to set.
# Set MINDDY_FORGE_RELAY=0 (installer: --no-forge-relay) to opt out entirely:
# nothing ever contacts minddy infrastructure and only operator-owned apps
# below are used. An operator-owned app, when configured, takes precedence for
# NEW connections; an existing connection keeps the channel it was established
# through until it is reconnected via the other.
# The variables below OVERRIDE the automatic provisioning (pinned control
# plane, self-hosted relay, staging). Credentials are issued from the
# operator's minddy Cloud account.
MINDDY_FORGE_RELAY=
MINDDY_FORGE_RELAY_URL=
MINDDY_FORGE_RELAY_INSTANCE_ID=
MINDDY_FORGE_RELAY_SECRET=
# Webhook fan-out: HMAC secret GENERATED by this instance and pushed to the
# relay over the authenticated channel; Cloud signs every fanned-out GitHub
# delivery with it (X-Hub-Signature-256). Automatic provisioning generates
# and stores one; set this only to pin an explicit secret.
MINDDY_FORGE_RELAY_WEBHOOK_SECRET=

# ── Cloud code agent (MIN-46) ────────────────────────────────────────────────
#The numo agent clones the linked repository (MIN-47) into a Vercel Sandbox (microVM
#isolated), edit the code, run install/build/tests, push a branch and open
#ONE PR per ticket. The default model lives in app_config (agent_model key =
#deepseek/deepseek-v4-flash), overloaded by the user preference then by run.
#
#Set `AGENT_EXECUTION_BACKEND=self-hosted` with AGENT_RUNNER_URL and
#AGENT_RUNNER_SECRET for the reference server runner, or `vercel` for Vercel
#Sandbox. `MINDDY_EDITION=cloud` does not select a backend implicitly. `local`
#permits only desktop-initiated runs; scheduled routines need a server backend.
#Leave blank only when agent execution and routines are intentionally disabled.
AGENT_EXECUTION_BACKEND=
AGENT_RUNNER_URL=
AGENT_RUNNER_SECRET=
#Optional internal origin used by server sandboxes to reach the control plane.
AGENT_CONTROL_ORIGIN=
#
#Pre-provisioned Sandbox Snapshot (node/git/tools) → almost instant start.
#Optional: without it, each run reinstalls the tools at boot (~30s).
AGENT_SANDBOX_SNAPSHOT_ID=
#BYOK key encryption (AES-256-GCM, 32+ bytes) — OpenRouter keys that
#users provide for unlimited use. Absent → BYOK unavailable (fail-closed).
AI_KEY_ENCRYPTION_SECRET=
#Shared secret of /api/cron/* routes. Vercel Cron can call them, but everything
#HTTP scheduler is suitable. Absent → inert roads (401), no substantive work.
#The vercel.json maintains the schedules of the hosted product. Excluding Vercel, this file
#is ignored; on Vercel, remove `crons` if you don't want to program them.
CRON_SECRET=

# ── Analytics PostHog (MIN-78) ───────────────────────────────────────────────
#Absent → PostHog is never initialized: the app runs normally, none
#event is not emitted (neither client nor server). This is local behavior.
#
#TO DO IN POSTHOG (once, when creating the project):
#
#1. REGISTER AT https://eu.posthog.com — not us.posthog.com. The region
#is determined by the registration domain and is NOT editable
#then (inter-region migration is reserved for paid plans). There
#minddy's Confidentiality page announces EU accommodation: go to the
#US region would make it false from the first event.
#2. Settings → Project → “Project API key” (the write-only token, phc_…) →
#MINDDY_PUBLIC_POSTHOG_KEY and POSTHOG_API_KEY below. The same key is used
#to the browser and the server: it only allows you to WRITE events,
#hence the absence of risk in exposing it on the client side.
#3. (optional, PAID) Group analytics is a billed add-on. The code sends
#already the `project` group on the relevant events; without the add-on they
#leave anyway, PostHog simply does not offer splitting by
#project in the UI. To be activated only if the analysis by project becomes
#useful — nothing to rewire the day you do it.
#4. (optional) Settings → Project: cut Autocapture and Session replay.
#The code already deactivates them at init (`autocapture: false`,
#`disable_session_recording: true`) — it is a belt in addition to the
#strap, so that a future misconfigured SDK does not reopen the collection.
#5. (optional) Set the retention of events for the duration announced in
#Privacy page. EU organizations already have IP capture
#disabled by default (GDPR), nothing to do on this side.
#
#PUBLIC key of the project (phc_…) — exposed to the browser, this is normal.
MINDDY_PUBLIC_POSTHOG_KEY=
#Explicit ingestion host: No regions or instances are silently chosen.
MINDDY_PUBLIC_POSTHOG_HOST=
#
#Server key for authoritative events (registration, Stripe subscription,
#tickets created by MCP/Numo/agent, agent runs, public feedback, crons). In
#uses the SAME project key as above: posthog-node does not need
#more to write. The server pair is independent: key without POSTHOG_HOST
#doesn't enable anything and never combines with MINDDY_PUBLIC_POSTHOG_HOST. If she
#is entirely absent, the server can reuse the full public pair.
#An operator can therefore activate only the browser, only the server,
#or both, to its own PostHog Cloud or self-hosted endpoint.
POSTHOG_API_KEY=
POSTHOG_HOST=
#
#Dev only: =1 authorizes PostHog locally, CLIENT AND SERVER, for
#check event wiring. Any other value (0, empty, absent) →
#nothing starts from a `pnpm dev`: neither browser events, nor those of
# server routes (`issue_created_server`, `user_signed_up`, `agent_run_*`…).
#This is the setting to leave by default: it is enough to isolate the development
#real statistics, without having to create a second PostHog project.
#Warning: it is a NEXT_PUBLIC_* variable, therefore inlined in the build — after
#having changed it, restart `pnpm dev`.
MINDDY_PUBLIC_POSTHOG_ALLOW_LOCALHOST=

#── minddy Managed Services (MIN-373) ──────────────────── ────────────────────
#The installation is SELF-HOSTED by default: no Stripe calls or managed AI
#quota starts from the mere presence of a key. Managed services require both
#MINDDY_EDITION=cloud and their own explicit =1 flag with complete configuration.
#
#Cloud minddy: MINDDY_MANAGED_BILLING=1 offers Stripe subscriptions;
#MINDDY_MANAGED_AI=1 authorizes the OpenRouter platform key and its quota/ledger.
#Self-hosting: leave these two variables empty. Configure instead
#a BYOK key (account settings) or a local endpoint; these calls are under
#the control and the invoice of the operator of the instance.
MINDDY_MANAGED_BILLING=
MINDDY_MANAGED_AI=

#Stripe subscription: required with MINDDY_MANAGED_BILLING=1. The webhook points
#on /api/stripe/webhook (checkout.session.completed,
#customer.subscription.*, invoice.payment_failed). Incomplete or disabled →
#no Stripe checkout, portal or event processing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_GO=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_GO_YEARLY=
STRIPE_PRICE_ID_PRO_YEARLY=

# ── “New version” banner (MIN-157) ───────────────────────────────────────────
#NOTHING TO DEFINE HERE — the variable is documented, not requested.
#
#VERCEL_GIT_COMMIT_SHA is injected by Vercel into each deployment when
#“Automatically expose System Environment Variables” is checked (Settings →
#Environment Variables). next.config.mjs the bridge in NEXT_PUBLIC_GIT_COMMIT_SHA
#(inlined with the build, therefore fixed to the version loaded in the tab), and
#/api/version returns that of the deployment which serves the traffic: a difference between
#both displays the banner. No Vercel API token is required.
#
#Absent — locally, or the option unchecked — both are "" and detection
#remains silent: neither request nor blindfold.

# ── macOS desktop app (MIN-292) ──────────────────────────────────────────────
#The public folder that serves `latest-mac.yml` and binaries — a Vercel store
#Public Blob is enough, and that's what we use ("minddy-desktop"). Provider
#`generic` from electron-updater and not `github`: the repository is private, and the
#provider GitHub would require embedding a token in a distributed app.
#
#TWO readers, which must see the SAME value, otherwise the fault is silent:
#- electron-builder copies it into the `app-update.yml` INSIDE the bundle,
#at the time of packaging. Absent that day, the installed app is not looking
#never anywhere — and nothing says it.
#- /api/desktop/download reads it to redirect to the .dmg of the last
#version. Absent, the download page responds 503 rather than lying.
MINDDY_DESKTOP_FEED_URL=

#Writing to the store, read by scripts/publish-desktop.mjs ONLY: the
#site only does public readings. Lay this value in secret
#store of the deployment provider, never in the repository.
BLOB_READ_WRITE_TOKEN=

#Apple notarization keychain profile name, created once with
#`xcrun notarytool store-credentials`. It's not the password: this one
#remains in the keychain of the publishing machine.
APPLE_KEYCHAIN_PROFILE=
