# minddy environment template
#
# Copy this file to .env and replace the values for the instance you are
# running. Empty optional values disable the corresponding integration.
# Never commit .env or real credentials.
#
# Secret values used for encryption, HMAC signatures, or webhook validation are
# checked at startup. Generate them with `openssl rand -hex 32` unless a
# provider requires a different format. Optional secrets may stay empty; a
# non-empty secret must still meet the minimum length enforced by the app.

# =============================================================================
# 1. Instance identity and public URLs
# =============================================================================

# Canonical public origin for this instance, without a path or trailing slash.
# Development falls back to http://localhost:3000 when this is empty. Set it
# for any public deployment so invitation links, OAuth, MCP, webhooks, and
# metadata point to the correct host.
MINDDY_PUBLIC_APP_URL=

# Server-side edition. Leave this empty or use self-hosted for an operator-
# managed installation. Minddy Cloud sets cloud explicitly; the hostname,
# Git branch, and Vercel environment do not select the edition.
MINDDY_EDITION=self-hosted

# Optional public branding for an operator-distributed instance. Empty values
# keep the default project branding.
MINDDY_PUBLIC_SITE_NAME=
MINDDY_PUBLIC_CONTACT_EMAIL=

# Optional Share Feedback link. Leave empty to hide the link.
MINDDY_PUBLIC_PRODUCT_FEEDBACK_URL=

# Set to a truthy value to mount Vercel Analytics and Speed Insights. Empty
# means that no Vercel measurement component is mounted.
MINDDY_PUBLIC_VERCEL_ANALYTICS=

# =============================================================================
# 2. Supabase and core application access
# =============================================================================

# Supabase Dashboard -> Project Settings -> API.
MINDDY_PUBLIC_SUPABASE_URL=
MINDDY_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service_role key. It is never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated administrator email addresses. Accounts with
# app_metadata.role = "admin" are accepted as well.
ADMIN_EMAILS=

# OAuth 2.1 issuer advertised by the .well-known documents. Leave empty in the
# normal case: production uses the canonical app URL, previews use their own
# deployment URL, and local development uses localhost. Set it only when the
# app is reached through another stable address, such as an ngrok tunnel.
# Never derive this value from a request header.
OAUTH_ISSUER=

# =============================================================================
# 3. Security secrets
# =============================================================================

# AES-256-GCM key for public feedback board SSO secrets (32+ bytes). Set this
# before deploying an instance whose boards already use SSO. Without it, new
# SSO secrets cannot be generated; existing secrets remain readable and are
# resealed when the key becomes available.
FEEDBACK_SSO_ENCRYPTION_SECRET=

# HMAC key for Git connection state values (32+ bytes).
GIT_STATE_SECRET=

# AES-256-GCM key for user-provided AI keys (32+ bytes). Empty disables BYOK.
AI_KEY_ENCRYPTION_SECRET=

# Shared secret for /api/cron/* routes. Vercel Cron or another scheduler must
# send it; empty routes are inert and return 401.
CRON_SECRET=

# =============================================================================
# 4. AI and agent execution
# =============================================================================

# OpenRouter key used by the managed assistant and server-side AI features.
# The assistant model and fallback model are configured in the app_config table.
OPENROUTER_API_KEY=

# Optional OpenRouter provisioning key. When present, each code-agent run gets
# a hard-ceiling key injected by its sandbox firewall. Empty falls back to
# OPENROUTER_API_KEY without a provider-side spending ceiling.
OPENROUTER_PROVISIONING_KEY=

# Agent execution backend:
#   self-hosted -> use AGENT_RUNNER_URL and AGENT_RUNNER_SECRET
#   vercel      -> use Vercel Sandbox
#   local       -> allow desktop-initiated runs only
# Leave empty to disable server-side agent execution and scheduled routines.
AGENT_EXECUTION_BACKEND=
AGENT_RUNNER_URL=
AGENT_RUNNER_SECRET=

# Optional internal origin used by a server sandbox to reach the control plane.
AGENT_CONTROL_ORIGIN=

# Optional pre-provisioned sandbox snapshot containing Node, Git, and tools.
# Without it, each run installs its tools during startup.
AGENT_SANDBOX_SNAPSHOT_ID=

# =============================================================================
# 5. Application email and authentication dashboard settings
# =============================================================================

# Email sent by the application, separate from Supabase Auth email.
# Use `console` locally to display codes and links without network access. Use
# `resend` only when the API key and both sender addresses are configured; the
# console provider is refused in production.
EMAIL_PROVIDER=
RESEND_API_KEY=
FEEDBACK_EMAIL_FROM=
INVITATION_EMAIL_FROM=

# Supabase Auth email is configured in the Supabase Dashboard, not here:
#
# 1. Configure Google and GitHub under Authentication -> Sign In / Providers.
#    Their provider callback is
#    https://<project-ref>.supabase.co/auth/v1/callback.
# 2. Under Authentication -> URL Configuration, add:
#      https://<public-origin>/auth/callback
#      http://localhost:3000/auth/callback
#      https://*-<team>.vercel.app/auth/callback (preview deployments)
# 3. Configure a verified SMTP provider under Authentication -> Emails ->
#    SMTP Settings. Without custom SMTP, Supabase sends from noreply@supabase.co
#    and applies a low test-only rate limit.
# 4. Set Site URL to the public origin and keep it aligned with the redirect
#    allowlist. This prevents production confirmation links from pointing to
#    localhost.
# 5. Use supabase/email-templates/confirm-signup.html for the Confirm signup
#    template. Its PKCE-safe link should use token_hash and type=signup rather
#    than the default code-based ConfirmationURL.
#
# Supabase also owns password policy, leaked-password protection, JWT expiry,
# refresh-token rotation, Auth rate limits, and TOTP/MFA. Review those settings
# after every Supabase project change. The login flow expects an 8-character
# minimum password and TOTP enabled for the global aal2 gate.

# =============================================================================
# 6. Web Push and native desktop notifications
# =============================================================================

# Web Push VAPID pair. Generate once with `npx web-push generate-vapid-keys`.
# Do not rotate the pair casually: existing browser subscriptions are tied to
# the public key. All three values must be present to enable delivery.
MINDDY_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Native macOS push via Apple Push Notification service. Keep the .p8 private
# key server-side; use literal `\n` escapes if the deployment system accepts
# only a single line. APNS_BUNDLE_ID must identify the signed application.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# Native Windows push via Windows Push Notification Services and the Windows
# App SDK Entra flow. WNS is currently parked and managed deployments leave
# these values empty. The implementation remains available for later use; all
# three server values plus the desktop AppId, Object ID, and PFN mapping must be
# configured together before enabling it. See docs/desktop-release.md.
WNS_TENANT_ID=
WNS_APP_ID=
WNS_CLIENT_SECRET=

# =============================================================================
# 7. GitHub and GitLab integrations
# =============================================================================

# These integrations are optional. An incomplete provider configuration is
# treated as disabled. Both providers need GIT_STATE_SECRET above.

# GitHub App: https://github.com/settings/apps/new
# Required permissions include Contents (read/write), Pull requests
# (read/write), Metadata (read), and Issues (read/write).
# Setup URL: https://<public-origin>/api/git/github/setup
# Webhook URL: https://<public-origin>/api/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional user authorization for the same GitHub App. The callback URL is:
# https://<public-origin>/api/git/github/user-callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# GitLab OAuth application: https://gitlab.com/-/profile/applications
# Redirect URI: https://<public-origin>/api/git/gitlab/callback; scope: api.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Use GIT_TOKEN_ENCRYPTION_SECRET for new installations. The older
# GITLAB_TOKEN_ENCRYPTION_SECRET name remains a compatibility alias; configure
# only one of them because both encrypt forge access tokens.
GITLAB_TOKEN_ENCRYPTION_SECRET=
GIT_TOKEN_ENCRYPTION_SECRET=

# Migration-only GitLab webhook secret. It is accepted only for a registered
# repository that has no dedicated encrypted secret yet, and requires
# GIT_TOKEN_ENCRYPTION_SECRET so the first delivery can revoke it by rotating
# the hook. Remove this value after all older hooks have migrated.
GITLAB_WEBHOOK_SECRET=

# =============================================================================
# 8. Managed forge relay
# =============================================================================

# On self-hosted installations the relay is enabled by default and provisions
# its identity on first connection. Set MINDDY_FORGE_RELAY=0 to opt out; only
# operator-owned GitHub/GitLab apps are then used. An operator-owned app takes
# precedence for new connections, while existing connections keep their channel
# until they are reconnected.
MINDDY_FORGE_RELAY=

# Optional overrides for a pinned relay or a non-production control plane.
# Credentials are issued from the operator's minddy Cloud account.
MINDDY_FORGE_RELAY_URL=
MINDDY_FORGE_RELAY_INSTANCE_ID=
MINDDY_FORGE_RELAY_SECRET=

# Optional explicit HMAC secret for relay webhook fan-out. The normal flow
# generates and stores this secret during provisioning.
MINDDY_FORGE_RELAY_WEBHOOK_SECRET=

# =============================================================================
# 9. Vercel custom domains
# =============================================================================

# Vercel project credentials used by the Custom Domain section. Leave all
# values empty to hide that section.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Development-only Vercel API mock. Set to 1 to exercise the complete flow
# locally without a token; it is ignored in production.
MDY_FAKE_VERCEL_DOMAINS=

# Comma-separated minddy.app subdomains allowed for dogfooding, for example
# feedback.minddy.app. Wildcard subdomains and the app hosts are rejected.
MDY_CUSTOM_DOMAIN_ALLOWLIST=

# =============================================================================
# 10. PostHog analytics
# =============================================================================

# Leave all PostHog values empty to disable analytics. Register the project in
# the EU region at https://eu.posthog.com when the privacy policy promises EU
# hosting. The public and server keys may be the same project key.

# Browser key and ingestion host. The key is write-only and is safe to expose
# to the browser.
MINDDY_PUBLIC_POSTHOG_KEY=
MINDDY_PUBLIC_POSTHOG_HOST=

# Optional server-side key and host for authoritative events. If both are
# empty, the server can reuse the public pair.
POSTHOG_API_KEY=
POSTHOG_HOST=

# Development-only opt-in for browser and server analytics on localhost. Set
# to 1, then restart the dev server because this public variable is build-time.
MINDDY_PUBLIC_POSTHOG_ALLOW_LOCALHOST=

# =============================================================================
# 11. Minddy Cloud managed services and Stripe
# =============================================================================

# Managed services are opt-in. They require MINDDY_EDITION=cloud plus the
# matching explicit flag. Self-hosted operators should leave both empty and
# use BYOK or an operator-owned AI endpoint instead.
MINDDY_MANAGED_BILLING=
MINDDY_MANAGED_AI=

# Stripe is required only when MINDDY_MANAGED_BILLING=1. The webhook endpoint
# is /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_GO=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_GO_YEARLY=
STRIPE_PRICE_ID_PRO_YEARLY=

# =============================================================================
# 12. macOS desktop distribution
# =============================================================================

# Public Blob URL serving latest-mac.yml and desktop binaries. The packaging
# step and /api/desktop/download must use the same value.
MINDDY_DESKTOP_FEED_URL=

# Write credential used only by scripts/publish-desktop.mjs. Never expose it to
# the application or commit it.
BLOB_READ_WRITE_TOKEN=

# Keychain profile created with `xcrun notarytool store-credentials` on the
# publishing Mac. This is a profile name, not the Apple password.
APPLE_KEYCHAIN_PROFILE=

# =============================================================================
# 13. Deployment notes
# =============================================================================

# Vercel injects VERCEL_GIT_COMMIT_SHA when system environment variables are
# exposed. next.config.mjs bridges it into NEXT_PUBLIC_GIT_COMMIT_SHA for the
# new-version banner; no value is required here.
#
# For self-hosted Docker deployments, use deploy/self-hosted/.env.example. It
# contains release pins, network settings, the agent runner, and the official
# Supabase Compose variables needed by the complete profile.

# =============================================================================
# 14. Linux desktop release
# =============================================================================

# Local signing only. Import the ASCII-armored private key into an isolated GPG
# home before running scripts/sign-linux-desktop.mjs; do not put private key
# material in this file. MINDDY_DESKTOP_FEED_URL and BLOB_READ_WRITE_TOKEN from
# section 12 are also required when publishing the verified artifacts.
MINDDY_LINUX_GPG_FINGERPRINT=
MINDDY_LINUX_GPG_PASSPHRASE=

# The protected GitHub `public-release` environment uses differently named
# values: LINUX_GPG_PRIVATE_KEY and LINUX_GPG_PASSPHRASE as secrets, and
# LINUX_GPG_FINGERPRINT as a variable. See docs/linux-desktop.md before a
# public release.
