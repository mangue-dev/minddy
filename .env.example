# minddy — Supabase (instance dédiée, séparée d'AutoKap)
# Copie ces clés dans .env (gitignoré) avec les vraies valeurs de ton projet Supabase.

# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role (secret serveur — jamais exposée au client).
# Pas encore consommée au chantier « Fondations », documentée pour le chantier « Projets ».
SUPABASE_SERVICE_ROLE_KEY=
