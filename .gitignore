# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# Applications du monorepo : les sorties Next et leurs liens pnpm restent
# locales à chaque projet, pas seulement à la racine.
/apps/*/.next/
/apps/*/node_modules/

# production
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo

# Fichiers locaux et documents internes — aucun ne doit rejoindre le dépôt
# public. Un fichier déjà suivi doit aussi être retiré de l'index avec
# `git rm --cached <fichier>` : cette liste protège les futurs ajouts.
/dev.log
/problems.md
/tsconfig.tsbuildinfo
/copy-audit*.json
/copy-audit*.md
/*-plan.md
/.claude/settings.json
/captures/world/world.md
/docs/audits/securite-2026-08-05.md
/docs/desktop-signing.md
/docs/rgpd/registre-des-traitements.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*
!.env.example

# vercel
.vercel

assets/figma
# Rendus PNG figés d'Icon Composer (iOS/watchOS) : aucun consommateur dans le
# dépôt — la source, elle, est desktop/build/icon.icon.
assets/mac-desktop-icon-exports/
# supabase CLI link artifacts
supabase/.temp/

# bundle du harness de la microVM (MIN-224) — reconstruit au prebuild
/.agent-vm/

# bundle de la projection markdown des pages (MIN-295) — reconstruit au prebuild,
# au predev, et par le globalSetup de vitest
/.pages-md/

# coquille de l'app de bureau (MIN-291) — le bundle esbuild et ses deps Electron
/desktop/node_modules
/desktop/dist
# les binaires empaquetés (MIN-292). `desktop/build/`, lui, N'EST PAS ignoré :
# l'icône `.icns` et les entitlements sont des sources, pas des artefacts.
/desktop/release
