# Self-hosted instance served by the managed forge relay: the relay is
# configured, the operator-owned forge apps are absent, and the instance must
# start and report the relay provider without ever reading local app variables.
MINDDY_TEST_EDITION=managed-forge
MINDDY_TEST_EXPECT_BILLING=0
MINDDY_TEST_EXPECT_AI=0
MINDDY_TEST_BYOK=0
MINDDY_TEST_PARTIAL=
MINDDY_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
MINDDY_PUBLIC_SUPABASE_ANON_KEY=fake-anon-key
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key-with-40-characters-minimum
MINDDY_FORGE_RELAY_URL=https://forge-relay.minddy.app
MINDDY_FORGE_RELAY_INSTANCE_ID=fake-instance-id
MINDDY_FORGE_RELAY_SECRET=fake-instance-relay-secret-32-chars
MINDDY_FORGE_RELAY_WEBHOOK_SECRET=fake-relay-webhook-secret-32-chars-x
GIT_STATE_SECRET=fake-git-state-secret-with-32-characters
# Relayed tokens are stored encrypted instance-side, like local ones.
GIT_TOKEN_ENCRYPTION_SECRET=fake-git-token-encryption-secret-32ch
MINDDY_MANAGED_BILLING=
MINDDY_MANAGED_AI=
MINDDY_MANAGED_FORGE=
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_GO=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_GO_YEARLY=
STRIPE_PRICE_ID_PRO_YEARLY=
# Operator-owned forge apps deliberately absent: the relay replaces them.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
